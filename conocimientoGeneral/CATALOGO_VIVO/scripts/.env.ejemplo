# Copia este archivo como `.env` (que NUNCA se sube: el repositorio es público) y
# llena los valores. Si no existe `.env` aquí, el script lee —solo lee— los de la
# carpeta de producción vecina; con `CATALOGO_ENV_DIR` puedes apuntarle a otra.

# ── Odoo (catálogo, free_qty, contenedor, fotos) ──────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# ── kubera: costos y tokens de ML / TikTok (solo SELECT) ──────────────────────
SUPABASE_DB_URL=
DB_ENCRYPTION_KEY=

# ── Amazon SP-API ─────────────────────────────────────────────────────────────
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=
AMAZON_SP_API_ENDPOINT=
AMAZON_LWA_TOKEN_URL=

# ── Walmart MX ────────────────────────────────────────────────────────────────
WM_CLIENT_ID=
WM_CLIENT_SECRET=

# ── TikTok Shop (el token de acceso sale de kubera) ───────────────────────────
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# ── Temu (solo responde desde la IP de producción) ────────────────────────────
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_API_BASE=
