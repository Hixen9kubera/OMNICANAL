# ─────────────────────────────────────────────────────────────────────────────
# .env.ejemplo — plantilla de llaves para generar_contenido_ml.py
#
# CÓMO SE USA
#   1. Copia este archivo como `.env` en esta misma carpeta.
#   2. Llena los valores DESPUÉS del `=`, sin comillas y sin espacios.
#   3. NUNCA subas el `.env` al repositorio.
#
# ⚠️ EL REPOSITORIO ES PÚBLICO (Hixen9kubera/OMNICANAL). El `.env` está en el
#    .gitignore de `conocimientoGeneral/`, pero la regla de verdad es esta:
#    en un archivo que se sube NO SE ESCRIBE NUNCA UNA LLAVE REAL. Este
#    ejemplo va con todos los valores VACÍOS a propósito.
#
# El script también acepta las variables exportadas en la terminal; lo que ya
# esté en el entorno MANDA sobre lo que diga este archivo.
# ─────────────────────────────────────────────────────────────────────────────


# ── WooCommerce — OBLIGATORIAS ───────────────────────────────────────────────
# De aquí sale el producto: título, descripción, atributos y las metas
# `ml_categoria_id` / `ml_category_id`. El script SOLO hace GET contra Woo.
#
# Las llaves se generan en WooCommerce → Ajustes → Avanzado → API REST.
# Con permiso de LECTURA basta y sobra: este script no escribe.
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=


# ── La IA — hace falta UNA de las dos ────────────────────────────────────────
# DeepSeek es el proveedor que usa producción (`config.py:83-85`). Su llave
# vive en Railway, servicio BackendOmnicanal.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude es el respaldo, igual que en producción (`ia_generadores.py:61-76`).
# Necesita el SDK oficial:  pip install anthropic
# Producción usa `claude-opus-4-8`; el script usa `claude-opus-5` por omisión.
# Si quieres calcar producción exactamente, escribe claude-opus-4-8 abajo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=


# ── Lo que este script NO necesita, y conviene que se sepa ───────────────────
# · Token de Mercado Libre. `/categories/{id}` y `/categories/{id}/attributes`
#   son PÚBLICOS (verificado 2026-09-03: HTTP 200 sin cabecera de auth).
# · Acceso a la BD kubera (Supabase). No se toca.
# · Acceso a MySQL / WordPress por SQL. No se toca.
# · Odoo. No se toca.
# · Credenciales de Amazon, TikTok, Temu o Walmart. No se tocan.
