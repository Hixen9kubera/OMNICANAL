{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python scripts/competencia_cron.py",
    "cronSchedule": "0 8 1 * *",
    "restartPolicyType": "NEVER"
  }
}
