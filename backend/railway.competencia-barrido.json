{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python scripts/competencia_barrido.py --real --tope 9",
    "cronSchedule": "0 13 1 * *",
    "restartPolicyType": "NEVER"
  }
}
