{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "laboratorio/Dockerfile",
    "watchPatterns": [
      "laboratorio/**",
      "backend/sandbox_precios/**",
      "backend/services/**",
      "backend/core/**",
      "backend/config.py",
      "backend/requirements.txt",
      ".dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/lab/salud",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
